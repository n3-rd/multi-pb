# Multi-PB Configuration
# Copy this file to .env and customize as needed

# External port for accessing all instances (default: 25983)
# This is the only port exposed from the container
MULTIPB_PORT=25983

# Data directory inside container (default: /var/multipb/data)
# Instances will be stored in subdirectories: {MULTIPB_DATA_DIR}/{instance_name}/
MULTIPB_DATA_DIR=/var/multipb/data
